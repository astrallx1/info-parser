# Secrets
GITHUB_TOKEN=
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini        # deliberately cheap; the pipeline is built to tolerate a weak model

# Runtime paths
COOKIES_PATH=./cookies.json   # X session cookies (from setup_x_login.py)
DB_PATH=./topics.db
PROFILES_PATH=./profiles.yaml
DEBUG_DIR=./debug             # per-run debug/run-*.json dumps

# ---------------------------------------------------------------------------
# Everything from here down is also editable in the app: Settings -> Tuning.
# Saving there rewrites these lines in place (comments kept) and applies to the
# NEXT run, no restart. The three exceptions are noted where they appear.
# ---------------------------------------------------------------------------

# Off-interest subjects (comma-separated, matched in code before scoring)
OFF_INTEREST=               # empty by default, name your own. A signal whose SUBJECT is one of these is dropped: the term in the name, or in the first 60 chars of the description. A passing mention further in ("use any LLM: Claude, Gemini, Grok") is NOT a match, since those are multi-model tools rather than a signal about one model. Each term is a WHOLE WORD: `grok` matches `grok-cli` and `ai-grok-wrapper` but not `grokking-algorithms`, and by the same rule `agent` no longer covers `agents` or `agentic` — list the forms you mean. A term with a SPACE (`stable diffusion`) matches both the prose form and the hyphenated repo name `stable-diffusion-webui`

# GitHub net
GH_PER_PAGE=100             # repos fetched per GitHub topic, by star rank (max 100). The pool is far bigger than any limit (topic:mcp alone matches ~24k), so this is a cost/coverage dial: it changes nothing about how repos are judged, only how many reach the scorer

# Scoring / freshness
SCORE_THRESHOLD=70            # a topic must score >= this to be shown
GH_FRESH_DAYS=60              # GitHub signal freshness window (pushed_at)
X_FRESH_DAYS=3               # tweet freshness window
FEED_FRESH_DAYS=7            # official-source freshness window (a month-old blog post is not what this source is for)

# X scraping
X_MAX_TWEETS=150            # tweets scraped per X source (account/list/search); higher = more signals + more LLM cost
X_MIN_DELAY=3               # min seconds paused between X sources (NOT in Settings: getting the pacing wrong gets the account rate-limited)
X_MAX_DELAY=8               # max seconds paused between X sources
X_MAX_SCROLLS=80            # max scrolls per X source. Where this stops: the loop has no exit for an exhausted timeline, so measure TWEETS, not scrolls. 40 was measured as the binding limit (48 tweets -> 89 at 80); past 80 the marginal scroll buys 0.73 signals against 1.18 for the first 40, so raising it further costs ~2.5 min per source for very little

# Tracking / trending
TRACK_STAGNANT_DAYS=21      # drop a tracked repo whose stars haven't grown in this many days
TREND_MIN_VELOCITY=50       # stars/day that triggers a "trending" breakout alert

# LLM batching
LLM_BATCH_SIZE=120          # split scoring into batches above this many signals. NOT in Settings: the gap-fill is tuned against this number

# UI + generated descriptions language: en (public default) or uk
APP_LANG=en
